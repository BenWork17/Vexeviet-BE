{
  "name": "@vexeviet/route-service",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "node -e \"for(const p of [\"dist\"])require('fs').rmSync(p,{recursive:true,force:true})\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@vexeviet/common": "workspace:*",
    "@vexeviet/config": "workspace:*",
    "@vexeviet/database": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "dotenv-cli": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0"
  }
}
