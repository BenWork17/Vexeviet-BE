{
  "name": "@vexeviet/booking-service",
  "version": "1.0.0",
  "description": "Booking Service for VeXeViet Platform - Handles seat reservation, booking management, and concurrency control",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "tsx --test src/services/review.service.test.ts src/validators/booking.validator.test.ts"
  },
  "dependencies": {
    "@vexeviet/common": "workspace:*",
    "@vexeviet/config": "workspace:*",
    "@vexeviet/database": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "uuid": "^9.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.10",
    "@types/uuid": "^9.0.8",
    "dotenv-cli": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
